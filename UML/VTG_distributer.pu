@startuml
actor Guide
actor "Japanese User" as JaUser
actor "English User" as EnUser

participant "AWS Chime\nMeeting" as Chime
participant "AWS Transcribe" as Transcribe
participant "AWS Translate" as Translate
participant "AWS Polly" as Polly
participant "Audio Distributor\n(e.g. WebSocket)" as Distributor
participant "User Device (En)" as EnDevice

== ガイド発話 ==
Guide -> Chime : Speak Audio (Ja)

== 日本語ユーザー向け ==
Chime -> JaUser : Audio Stream (Ja)\n(live)

== 英語ユーザー向け ==
Chime -> Transcribe : Send Audio Stream (Ja)
Transcribe -> Transcribe : Transcribe to Text (Ja)
Transcribe -> Translate : Text (Ja)
Translate -> Translate : Translate to Text (En)
Translate -> Polly : Text (En)
Polly -> Polly : Synthesize Audio (En)
Polly -> Distributor : Push Audio (En)
Distributor -> EnDevice : Stream Audio (En)
EnDevice -> EnUser : Play Audio

@enduml
